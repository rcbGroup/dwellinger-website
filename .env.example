# Dwellinger Environment Variables
# Copy this file to .env.local and fill in values. Never commit .env.local.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI — Ask Dwellinger chat (optional; chat is disabled if unset)
OPENAI_API_KEY=your_openai_key

# Site URLs
NEXT_PUBLIC_SITE_URL=https://dwellinger.co.uk
NEXT_PUBLIC_BASE_URL=https://dwellinger.co.uk

# Google Analytics (optional; must be behind consent gate)
NEXT_PUBLIC_GA4_ID=

# Internal API secret — protects /api/push/send; generate a long random string
INTERNAL_API_SECRET=

# Web Push / VAPID (for PWA push notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@dwellinger.co.uk

# Lead webhook (optional; no PII — receives form type + record id only)
LEAD_WEBHOOK_URL=

# Search engine verification
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# IndexNow key (matches the key served at /indexnow-key.txt)
INDEXNOW_KEY=

# Companies House API key (optional; enables live /tools/check-a-builder)
COMPANIES_HOUSE_API_KEY=
